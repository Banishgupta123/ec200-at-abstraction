# clang-tidy configuration for the EC200 library.
#
# Enabled: the clang static analyzer plus the check families that find real
# defects in C (bugprone, cert, portability, performance, misc).
#
# Deliberately disabled:
#   misc-include-cleaner            - wants every transitively used symbol's
#                                     header included directly, which fights
#                                     this library's aggregate-header design
#                                     (ec200.h pulls in the module headers).
#   bugprone-easily-swappable-parameters
#                                   - an API-shape observation, not a defect;
#                                     acting on it would break the public API.
#   cert-err34-c / bugprone-unchecked-string-to-number-conversion
#                                   - the premise does not hold here: every
#                                     sscanf() return value is checked at its
#                                     call site, and every atoi() is preceded
#                                     by an explicit digit validation (see
#                                     record_error() and parse_reg_status()).
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  portability-*,
  performance-*,
  misc-*,
  -misc-include-cleaner,
  -bugprone-easily-swappable-parameters,
  -cert-err34-c,
  -bugprone-unchecked-string-to-number-conversion
WarningsAsErrors: '*'
HeaderFilterRegex: 'include/ec200.*\.h$'
FormatStyle: none
