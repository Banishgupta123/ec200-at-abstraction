# Normalise line endings: sources always LF, regardless of platform.
* text=auto
*.c   text eol=lf
*.h   text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.txt text eol=lf
CMakeLists.txt text eol=lf
Doxyfile       text eol=lf
LICENSE        text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
